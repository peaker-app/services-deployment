# ================== ASP.NET Core ==================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080

# ================== PostgreSQL + PostGIS (contenedor db-peak-service) ==================
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=peaker_peaks
POSTGRES_SERVER=db-peak-service

# ================== peak-service (configuración .NET, claves con __) ==================
ConnectionStrings__PeakDatabase=Server=db-peak-service;Port=5432;Database=peaker_peaks;Username=<POSTGRES_USER>;Password=<POSTGRES_PASSWORD>
Messaging__Host=rabbitmq
Messaging__Port=5672
Messaging__Username=
Messaging__Password=
Messaging__VirtualHost=/

# ================== Outbox (DESIGN.md §8.2) ==================
Outbox__PollingInterval=00:00:10
Outbox__BatchSize=20
# Tope de intentos antes de aparcar un mensaje envenenado, y espera entre reintentos con backoff
# exponencial acotado. El tope cubre de sobra la espera legitima de un envio de correo aplazado por
# la cuota global (DESIGN.md §4.6). Desaparcar es manual: ver README.md, Outbox.
Outbox__MaxAttempts=12
Outbox__RetryBackoffBase=00:00:30
Outbox__RetryBackoffCap=00:15:00
# Antiguedad del mensaje sin procesar mas viejo a partir de la cual /health/ready pasa a Degraded.
Outbox__PendingAgeThreshold=00:05:00

# ================== OpenTelemetry ==================
# Endpoint OTLP al que exportar trazas y metricas. Vacio = no se exporta a ningun sitio; las
# metricas se siguen registrando y se ven en /health/ready. Ejemplo: http://otel-collector:4317
OpenTelemetry__OtlpEndpoint=

# ================== Ingesta de Wikidata (worker peak-ingestion) ==================
IngestionWorker__Mode=Automatic
Ingestion__Endpoint=https://query.wikidata.org/sparql
Ingestion__UserAgent=PeakerIngestion/1.0 (https://github.com/peaker-app)
Ingestion__DelayBetweenRequests=00:00:02
Ingestion__RequestTimeout=00:02:00
# La carga completa se reparte en bandas de altitud, no en paginas LIMIT/OFFSET: WDQS corta a los
# 60 s y ordenar el catalogo entero (~87.700 picos) por pagina nunca converge. Una banda que agota
# reintentos se parte por la mitad y se reintenta, hasta MinElevationBandMeters.
Ingestion__ElevationBandMeters=250
Ingestion__MinElevationBandMeters=15
# Las bandas que agotan la biseccion no se dan por perdidas al momento: se reintentan una vez al
# final de la ejecucion tras esta espera, porque el fallo tipico es throttling de WDQS y se recupera
# solo con el tiempo. Si vuelven a fallar, la ejecucion acaba en Partial.
Ingestion__DeferredRetryDelay=00:01:00
Ingestion__MinElevationMeters=0
Ingestion__MaxElevationMeters=9000
# Las bandas de los extremos son abiertas (< min y >= max), asi que ningun pico queda fuera.
# Los nombres y alias se piden aparte, por lotes de QIDs.
Ingestion__NameBatchSize=500
# Idioma del nombre canónico (peaks.name).
Ingestion__Language=en
# Idiomas cuyas etiquetas y alias se guardan en peak_names (búsqueda multiidioma, RF-PIC-02).
# Se sobrescriben por índice; para cambiar la lista hay que redefinirla entera.
Ingestion__AlternativeNameLanguages__0=es
Ingestion__AlternativeNameLanguages__1=en
Ingestion__AlternativeNameLanguages__2=fr
Ingestion__AlternativeNameLanguages__3=zh
Ingestion__AlternativeNameLanguages__4=ar
Ingestion__AlternativeNameLanguages__5=it
Ingestion__AlternativeNameLanguages__6=de
Ingestion__AlternativeNameLanguages__7=ca
Ingestion__AlternativeNameLanguages__8=eu
Ingestion__AlternativeNameLanguages__9=gl
Ingestion__AlternativeNameLanguages__10=pt
Ingestion__DuplicateRadiusMeters=250
Ingestion__DuplicateNameSimilarity=0.6
# Límite opcional de registros por ejecución; vacío = sin límite.
# Ingestion__MaxRecords=1000

# ================== RabbitMQ (contenedor rabbitmq) ==================
# El contenedor rabbitmq se crea con las credenciales de auth-service.env; aquí solo se replican
# en Messaging__Username / Messaging__Password para que peak-service se conecte con las mismas.
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
