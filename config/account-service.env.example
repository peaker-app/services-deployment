# ================== ASP.NET Core ==================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080

# ================== MySQL (contenedor db-account-service) ==================
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=peaker_accounts
MYSQL_USER=
MYSQL_PASSWORD=

# ================== account-service (configuración .NET, claves con __) ==================
ConnectionStrings__AccountDatabase=Server=db-account-service;Port=3306;Database=peaker_accounts;Uid=<MYSQL_USER>;Pwd=<MYSQL_PASSWORD>
Messaging__Host=rabbitmq
Messaging__Port=5672
Messaging__Username=
Messaging__Password=
Messaging__VirtualHost=/

# ================== Validación JWT (JWKS del auth-service, red interna de compose) ==================
Jwt__Authority=http://auth-service:8080
Jwt__Issuer=peaker-auth
Jwt__Audience=peaker-api
Jwt__RequireHttpsMetadata=false

# ================== Cloudinary (avatares) ==================
# A partir de un CLOUDINARY_URL cloudinary://<ApiKey>:<ApiSecret>@<CloudName>
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=
Cloudinary__Folder=peaker/dev/avatars

# ================== RabbitMQ (contenedor rabbitmq) ==================
# El contenedor rabbitmq se crea con las credenciales de auth-service.env; aquí solo se replican
# en Messaging__Username / Messaging__Password para que account-service se conecte con las mismas.
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
