# ================== ASP.NET Core ==================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080

# ================== PostgreSQL (contenedor db-ascent-service) ==================
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=peaker_ascents
POSTGRES_SERVER=db-ascent-service

# ================== ascent-service (configuración .NET, claves con __) ==================
ConnectionStrings__AscentDatabase=Server=db-ascent-service;Port=5432;Database=peaker_ascents;Username=;Password=
Messaging__Host=rabbitmq
Messaging__Port=5672
Messaging__Username=
Messaging__Password=
Messaging__VirtualHost=/

# ================== Outbox (DESIGN.md §8.2) ==================
Outbox__PollingInterval=00:00:10
Outbox__BatchSize=20
# Tope de intentos antes de aparcar un mensaje envenenado, y espera entre reintentos con backoff
# exponencial acotado. El tope cubre de sobra la espera legitima de un envio de correo aplazado por
# la cuota global (DESIGN.md §4.6). Desaparcar es manual: ver README.md, Outbox.
Outbox__MaxAttempts=12
Outbox__RetryBackoffBase=00:00:30
Outbox__RetryBackoffCap=00:15:00
# Antiguedad del mensaje sin procesar mas viejo a partir de la cual /health/ready pasa a Degraded.
Outbox__PendingAgeThreshold=00:05:00

# ================== OpenTelemetry ==================
# Endpoint OTLP al que exportar trazas y metricas. Vacio = no se exporta a ningun sitio; las
# metricas se siguen registrando y se ven en /health/ready. Ejemplo: http://otel-collector:4317
OpenTelemetry__OtlpEndpoint=

# ================== Validación JWT (JWKS del auth-service, red interna de compose) ==================
Jwt__Authority=http://auth-service:8080
Jwt__Issuer=peaker-auth
Jwt__Audiences__0=peaker-ascent
Jwt__RequireHttpsMetadata=false

# ================== Servicios internos (DESIGN.md §8.1) ==================
PeakCatalog__BaseAddress=http://peak-service:8080/
PeakCatalog__RequestTimeout=00:00:03
ProfileDirectory__BaseAddress=http://account-service:8080/
ProfileDirectory__RequestTimeout=00:00:03

# ================== Cloudinary (fotos de ascensiones) ==================
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=
# Clave de token-based authentication (Cloudinary: Settings > Security). Sin ella el servicio no arranca.
Cloudinary__AuthTokenKey=
Cloudinary__Folder=peaker/dev/ascents

# ================== RabbitMQ (contenedor rabbitmq) ==================
# El contenedor rabbitmq se crea desde auth-service.env; se replican aquí para mantener coherencia.
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
