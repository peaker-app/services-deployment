# ================== ASP.NET Core ==================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080

# ================== YARP: destino del cluster de auth (red interna de compose) ==================
ReverseProxy__Clusters__auth__Destinations__auth-service__Address=http://auth-service:8080/

# ================== Validación JWT (JWKS del auth-service) ==================
Jwt__Authority=http://auth-service:8080
Jwt__Issuer=peaker-auth
Jwt__Audience=peaker-api
Jwt__RequireHttpsMetadata=false
