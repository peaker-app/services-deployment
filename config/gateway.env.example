# ================== ASP.NET Core ==================
# En produccion NO se toca aqui: docker-compose.prod.yml impone
# ASPNETCORE_ENVIRONMENT=Production por `environment:`, que tiene precedencia
# sobre `env_file:`. Asi este fichero sigue sirviendo para desarrollo.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080

# ================== YARP: destinos de los clusters (red interna de compose) ==================
ReverseProxy__Clusters__auth__Destinations__auth-service__Address=http://auth-service:8080/
ReverseProxy__Clusters__account__Destinations__account-service__Address=http://account-service:8080/
ReverseProxy__Clusters__peak__Destinations__peak-service__Address=http://peak-service:8080/
ReverseProxy__Clusters__ascent__Destinations__ascent-service__Address=http://ascent-service:8080/

# ================== Validación JWT (JWKS del auth-service) ==================
Jwt__Authority=http://auth-service:8080
Jwt__Issuer=peaker-auth
Jwt__Audiences__0=peaker-gateway

# NO subir a `true`, tampoco en produccion. JwtExtensions.cs construye el
# ConfigurationManager con `new HttpDocumentRetriever { RequireHttps = ... }`, que
# rechaza la Authority de arriba antes de pedirla por ser `http:`. El servicio
# arrancaria sin poder descargar el JWKS: todas las peticiones autenticadas 401 y
# el check `jwks` de /health/ready en rojo.
#
# El TLS que importa se termina en el ingress. Este salto no sale de la red bridge
# de compose ni cruza el host. Detalle en el runbook de produccion del README.
Jwt__RequireHttpsMetadata=false

# ================== Proxies de confianza (rate limit por visitante) ==================
# El BFF del portal reenvía X-Forwarded-For, pero el gateway solo la honra desde estas
# redes. Vacío = cabecera ignorada, que es lo seguro si el :8080 es alcanzable.
# 172.16.0.0/12 cubre las redes bridge por defecto de Docker, incluida la que usa
# el ingress para hablar con el gateway en produccion.
ForwardedHeaders__KnownNetworks__0=172.16.0.0/12
