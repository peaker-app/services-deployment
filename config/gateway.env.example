# ================== ASP.NET Core ==================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080

# ================== YARP: destinos de los clusters (red interna de compose) ==================
ReverseProxy__Clusters__auth__Destinations__auth-service__Address=http://auth-service:8080/
ReverseProxy__Clusters__account__Destinations__account-service__Address=http://account-service:8080/
ReverseProxy__Clusters__peak__Destinations__peak-service__Address=http://peak-service:8080/
ReverseProxy__Clusters__ascent__Destinations__ascent-service__Address=http://ascent-service:8080/

# ================== Validación JWT (JWKS del auth-service) ==================
Jwt__Authority=http://auth-service:8080
Jwt__Issuer=peaker-auth
Jwt__Audiences__0=peaker-gateway
Jwt__RequireHttpsMetadata=false

# ================== Proxies de confianza (rate limit por visitante) ==================
# El BFF del portal reenvía X-Forwarded-For, pero el gateway solo la honra desde estas
# redes. Vacío = cabecera ignorada, que es lo seguro si el :8080 es alcanzable.
# 172.16.0.0/12 cubre las redes bridge por defecto de Docker.
ForwardedHeaders__KnownNetworks__0=172.16.0.0/12
