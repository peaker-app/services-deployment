# ================== Next.js ==================
NODE_ENV=production
PORT=3000

# ================== Gateway (red interna de compose) ==================
# Nunca localhost: dentro de la red de contenedores localhost es el propio contenedor.
GATEWAY_URL=http://gateway:8080

# ================== SEO ==================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ================== Mapa (SC-03 y SC-04) ==================
# La Tile Usage Policy de OpenStreetMap prohíbe el uso intensivo:
# sustituir por un proveedor apto para producción antes del lanzamiento.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>

# ================== Secretos ==================
# Firma del state de OAuth y del destino post-login. Fuera de git.
AUTH_COOKIE_SECRET=
