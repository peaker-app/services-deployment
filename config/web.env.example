# ================== Next.js ==================
NODE_ENV=production
PORT=3000

# ================== Gateway (red interna de compose) ==================
# Nunca localhost: dentro de la red de contenedores localhost es el propio contenedor.
GATEWAY_URL=http://gateway:8080

# ================== SEO ==================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ================== Mapa (SC-03 y SC-04) ==================
# La Tile Usage Policy de OpenStreetMap prohíbe el uso intensivo:
# sustituir por un proveedor apto para producción antes del lanzamiento.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>

# ================== Secretos ==================
# Firma del state de OAuth y del destino post-login. Fuera de git.
AUTH_COOKIE_SECRET=

# Marca las cookies de sesion como Secure, y por tanto exige HTTPS.
#
# Este contenedor sirve un build de produccion de Next, asi que NODE_ENV vale
# `production` tambien en local. Sin esta variable las cookies saldrian con Secure
# en el stack de desarrollo, que va por HTTP: funciona en http://localhost porque
# los navegadores lo tratan como origen seguro, pero se rompe en silencio en
# cuanto entras por la IP de LAN o por 10.0.2.2 desde el emulador de Android.
#
# En desarrollo: false. docker-compose.prod.yml lo pone a true.
# Vacia o ausente: se decide por NODE_ENV, que es el comportamiento anterior.
AUTH_COOKIE_SECURE=false
