map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream portal {
    server web:3000;
}

upstream api {
    server gateway:8080;
}

log_format peaker '$remote_addr - $remote_user [$time_local] '
                  '"$request_method $uri $server_protocol" '
                  '$status $body_bytes_sent "$http_referer" "$http_user_agent"';

server {
    listen 80;
    server_name ${PEAKER_DOMAIN} ${PEAKER_API_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${PEAKER_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${PEAKER_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PEAKER_DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:peaker:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=300" always;

    access_log /var/log/nginx/access.log peaker;

    client_max_body_size 12m;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        proxy_pass http://portal;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_read_timeout 60s;
        proxy_buffering off;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${PEAKER_API_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${PEAKER_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PEAKER_DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:peaker:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=300" always;

    access_log /var/log/nginx/access.log peaker;

    client_max_body_size 12m;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        proxy_pass http://api;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 60s;
    }
}
