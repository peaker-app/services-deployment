# ================== ASP.NET Core ==================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080

# ================== MySQL (contenedor db-auth-service) ==================
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=peaker_auth
MYSQL_USER=
MYSQL_PASSWORD=

# ================== auth-service (configuración .NET, claves con __) ==================
ConnectionStrings__AuthDatabase=Server=db-auth-service;Port=3306;Database=peaker_auth;Uid=<MYSQL_USER>;Pwd=<MYSQL_PASSWORD>

# Clave privada RSA con la que auth-service firma los JWT (RS256) y que publica por JWKS.
# Obligatoria fuera de Development: el arranque falla si no está. Sin ella cada arranque y cada
# réplica generarían una clave distinta, invalidando los access tokens ya emitidos.
# Generar con:  openssl genrsa -out auth-signing.pem 2048
# Pegar el PEM completo en una sola línea sustituyendo los saltos por \n. Nunca se versiona.
AuthToken__PrivateKeyPem=

# Proveedor de correo transaccional (Resend), RF-AUT-02. Crear la API key en
# https://resend.com/api-keys con el dominio remitente verificado. Nunca se versiona.
# Sin API key, auth-service escribe el enlace de confirmación en el log de Development en lugar de
# enviarlo; fuera de Development el arranque falla.
EmailConfirmation__ApiKey=
EmailConfirmation__FromAddress=no-reply@peaker.io
EmailConfirmation__FromName=Peaker
# {token} se sustituye por el token de un solo uso. Apunta a la página del frontend que llama a
# POST /api/auth/email/confirm.
EmailConfirmation__ConfirmationLinkTemplate=http://localhost:3000/confirm-email?token={token}

Messaging__Host=rabbitmq
Messaging__Port=5672
Messaging__Username=
Messaging__Password=
Messaging__VirtualHost=/

# ================== RabbitMQ (contenedor rabbitmq) ==================
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
