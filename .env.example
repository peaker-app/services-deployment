# Variables que Compose sustituye en docker-compose.yml.
# Copiar a `.env` (fuera de git) y rellenar antes de construir el portal.
#
# A diferencia de los `config/*.env`, que se inyectan al contenedor en ejecucion,
# estas se pasan como argumentos de construccion: las paginas legales del portal
# se prerenderizan durante `npm run build` y Next incrusta las `NEXT_PUBLIC_*` en
# el bundle en ese mismo momento. Definirlas solo en `config/web.env` llega tarde
# y publicaria los marcadores y las URLs de desarrollo.
#
# Excepcion: PEAKER_DOMAIN y PEAKER_API_DOMAIN no son build args. Las consume el
# ingress en ejecucion para rellenar las plantillas de nginx.
#
# Detalle en LEGAL.md (ficha del titular) y en el runbook de produccion del README.

# ================== Dominios publicos (solo produccion) ==================
# Los dos apuntan por DNS a la IP del VPS. El certificado se emite para ambos en
# un unico lote, asi que el bloque TLS de api.<dominio> lee los ficheros que
# certbot deja en /etc/letsencrypt/live/${PEAKER_DOMAIN}/.
#
# PEAKER_DOMAIN     -> el portal (y su BFF por dentro)
# PEAKER_API_DOMAIN -> el gateway, que solo consume la app movil
PEAKER_DOMAIN=
PEAKER_API_DOMAIN=

# ================== Portal: URLs incrustadas en el bundle ==================
# Alimenta los canonical y los hreflang de todas las paginas. En produccion,
# https://<PEAKER_DOMAIN>. Sin esto el sitio se publica apuntando a localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ================== Portal: teselas del mapa ==================
# Vacias = se usan los valores por defecto de src/lib/map.ts (OpenStreetMap).
# Para produccion, el proveedor contratado (B5 de la auditoria de despliegue).
#
# OJO: son variables de cliente, asi que la API key acaba en el bundle publico.
# No es un fallo, es como funcionan las teselas, pero obliga a restringir la key
# por dominio en el panel del proveedor. Cada proveedor exige su propia
# atribucion, y va aqui, no en el JSX.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# ================== Ficha del titular (LSSI-CE art. 10) ==================
LEGAL_HOLDER=
LEGAL_TAX_ID=
LEGAL_ADDRESS=
LEGAL_EMAIL=

# Delegado de proteccion de datos. Vacio: no se designa (RGPD art. 37).
LEGAL_DPO=
